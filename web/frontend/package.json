{
  "name": "securechat-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:lab": "vite build --config vite.lab.config.ts",
    "test:lab": "playwright test --config playwright.lab.config.ts",
    "test:netattack": "playwright test --config playwright.netattack.config.ts",
    "test:mallory": "playwright test --config playwright.mallory.config.ts",
    "lint": "node lint/check.mjs",
    "format": "prettier --write src tests e2e *.ts *.json ../../eslint.config.mjs lint ../../attack_lab/frontend ../../attack_lab/e2e",
    "format:check": "prettier --check src tests e2e *.ts *.json ../../eslint.config.mjs lint ../../attack_lab/frontend ../../attack_lab/e2e",
    "typecheck": "tsc --noEmit",
    "setup:lint": "npm --prefix lint ci"
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@noble/curves": "2.4.0",
    "@pdf-lib/fontkit": "1.1.1",
    "node-forge": "1.4.3",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "regenerator-runtime": "0.14.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node-forge": "1.3.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "@axe-core/playwright": "4.14.0"
  }
}
