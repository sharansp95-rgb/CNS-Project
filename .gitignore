__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.pcap
*.pcapng
# ...except demo capture evidence, which is meant to be committed (see demo/README.md).
!demo/*.pcap
!demo/*.pcapng
.env

# Local user store: holds real hashed credentials from testing, never
# committed. See server/user_store.py.
data/

# TLS cert + key, generated locally per teammate by certs/generate_certs.py
# (see README.md). A committed private key would let anyone with repo
# access impersonate the server, which defeats the point of TLS.
certs/*.key
certs/*.crt
certs/*.pem

# Signed evidence exports (Stage B) -- contain real conversation content.
exports/

# Course-submission files kept locally, never committed.
CnsProj/
CNS_Review1_*.pptx

# Structured security event log (server/security_log.py) -- real activity data.
logs/

# macOS Finder metadata.
.DS_Store

# files moved aside for later deletion (never committed)
_to_delete/

# built by tools/make_submission_zip.sh
dist/

# Local presentation review files.
*.pptx

# Browser dependencies and generated test/build caches.
web/frontend/node_modules/
web/frontend/.vite/
web/frontend/test-results/
web/frontend/playwright-report/

# Timestamp authority private keys (default lives under ignored data/).
*.key
*tsa*.pem
# Synthetic public fixture key is intentionally shared; no private fixture keys.
!tests/fixtures/evidence_corpus/tsa_public.pem

# Separate sandbox browser test artifacts.
attack_lab/test-results/
attack_lab/playwright-report/
